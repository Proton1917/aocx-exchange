{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aocx:schema:document-profile:1.0",
  "title": "Optional document/1 profile",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "rev": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string"
    },
    "body": {},
    "state": {
      "type": "object",
      "properties": {
        "work": {
          "type": "string"
        },
        "knowledge": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "ref": {
            "$ref": "#/$defs/ref"
          }
        },
        "additionalProperties": true
      }
    },
    "scope": {
      "type": "string"
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "extensions": {}
  },
  "required": [
    "id",
    "rev",
    "kind",
    "text"
  ],
  "additionalProperties": true,
  "$defs": {
    "ref": {
      "type": "object",
      "required": [
        "id",
        "rev"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "rev": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "lab.measurement"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "body"
        ],
        "properties": {
          "body": {
            "type": "object",
            "required": [
              "unit"
            ],
            "properties": {
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          }
        }
      }
    }
  ]
}

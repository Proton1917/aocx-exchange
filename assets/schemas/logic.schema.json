{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aocx:schema:logic:1.0",
  "title": "AOCX authored logic expression",
  "$comment": "Authored schema. Runtime checks also enforce finite JSON values, UTF-8, unique binding names, and parser limits; validation establishes structure and preservation, not a proof of the represented claim.",
  "type": "object",
  "required": [
    "format",
    "expression"
  ],
  "properties": {
    "format": {
      "const": "aocx-logic/1"
    },
    "expression": {
      "$ref": "#/$defs/logicNode"
    }
  },
  "additionalProperties": true,
  "description": "Domain-authored logical structure. Predicate meanings, free variable interpretation, and source-text correspondence belong to the author and reader.",
  "$defs": {
    "logicNode": {
      "type": "object",
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true,
      "description": "An authored logic node. Known operators retain their fields and child order. Unknown operators and extra fields remain opaque JSON values.",
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "var"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "const"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "literal"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "call"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "name",
              "args"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "args": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/logicNode"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "bind"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "name",
              "bindings"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "bindings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "value"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {
                      "$ref": "#/$defs/logicNode"
                    }
                  },
                  "additionalProperties": true,
                  "$comment": "The executable validator additionally requires unique binding names."
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "set"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "binder",
              "body"
            ],
            "properties": {
              "binder": {
                "type": "string",
                "minLength": 1
              },
              "body": {
                "$ref": "#/$defs/logicNode"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "forall"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "binder",
              "body"
            ],
            "properties": {
              "binder": {
                "type": "string",
                "minLength": 1
              },
              "body": {
                "$ref": "#/$defs/logicNode"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "exists"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "binder",
              "body"
            ],
            "properties": {
              "binder": {
                "type": "string",
                "minLength": 1
              },
              "body": {
                "$ref": "#/$defs/logicNode"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "not"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "body"
            ],
            "properties": {
              "body": {
                "$ref": "#/$defs/logicNode"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "sequent"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "left",
              "right"
            ],
            "properties": {
              "left": {
                "$ref": "#/$defs/logicNode"
              },
              "right": {
                "$ref": "#/$defs/logicNode"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "and"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "left",
              "right"
            ],
            "properties": {
              "left": {
                "$ref": "#/$defs/logicNode"
              },
              "right": {
                "$ref": "#/$defs/logicNode"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "or"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "left",
              "right"
            ],
            "properties": {
              "left": {
                "$ref": "#/$defs/logicNode"
              },
              "right": {
                "$ref": "#/$defs/logicNode"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "implies"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "left",
              "right"
            ],
            "properties": {
              "left": {
                "$ref": "#/$defs/logicNode"
              },
              "right": {
                "$ref": "#/$defs/logicNode"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "iff"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "left",
              "right"
            ],
            "properties": {
              "left": {
                "$ref": "#/$defs/logicNode"
              },
              "right": {
                "$ref": "#/$defs/logicNode"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "in"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "left",
              "right"
            ],
            "properties": {
              "left": {
                "$ref": "#/$defs/logicNode"
              },
              "right": {
                "$ref": "#/$defs/logicNode"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "eq"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "left",
              "right"
            ],
            "properties": {
              "left": {
                "$ref": "#/$defs/logicNode"
              },
              "right": {
                "$ref": "#/$defs/logicNode"
              }
            }
          }
        }
      ]
    }
  }
}
